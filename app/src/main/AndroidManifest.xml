<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The place picker reads one fix; the place watch reads one every few minutes to an hour,
         at a cadence it sets itself from how far the nearest place is and how fast the phone
         is moving (PlaceWatcher). No service, no continuous updates. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "Allow all the time": a place reminder that only works while the app is open is not a
         place reminder. Asked for separately, and only once a reminder actually needs it. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Self-update from GitHub Releases: fetch version.json + the APK, prompt through a
         notification, install through PackageInstaller, re-check after boot and after the
         update itself. ACCESS_NETWORK_STATE is what WorkManager's "connected" constraint reads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Firing. USE_EXACT_ALARM rather than asking for SCHEDULE_EXACT_ALARM: telling somebody
         at the minute they chose IS this app, which is exactly what that permission is for, and
         it spares a permission dance on every install. SCHEDULE_EXACT_ALARM is kept for the
         versions that predate it (it was granted on sight there). -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Taking the screen while the phone is unlocked and in somebody's hand: Android forbids a
         background app from starting an activity unless it may draw over other apps, and there
         is no way to tell an open app from the home screen without usage access. Both are
         granted by hand in system settings (Settings names them when they are missing), and
         without them the alert simply arrives as a banner — the system's own behaviour. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- allowBackup off: reminders are personal, and the backup story is deliberately the app's
         own (the vault: sealed with the person's passphrase, off by default — see vault/), not a
         transfer to whoever controls the Google account. -->
    <application
        android:name=".RwilcoApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rwilco">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Rwilco">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A line of text shared from another app becomes a new reminder with those words. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Hold the launcher icon: "Nuevo". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The alert taking over the screen: over the lock screen, turning it on, and out of
             recents so a dismissed alarm leaves nothing behind to swipe. -->
        <activity
            android:name=".ui.alert.AlertActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=".alert"
            android:theme="@style/Theme.Rwilco" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.AlertActionReceiver"
            android:exported="false" />

        <!-- The sound that comes back every few minutes until a reminder is dealt with. -->
        <receiver
            android:name=".alarm.SoundRepeatReceiver"
            android:exported="false" />

        <!-- A reboot, an install over ourselves, or the clock moving: all mean "work out when
             everything rings again". -->
        <receiver
            android:name=".geo.GeofenceReceiver"
            android:exported="false" />

        <!-- The place watch's own alarm: look where the phone is, decide when to look again. -->
        <receiver
            android:name=".geo.PlaceCheckReceiver"
            android:exported="false" />

        <receiver
            android:name=".system.SystemEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!--
          The app's own copies of the sounds somebody chose. A notification channel's tone is
          played by the system, and the system cannot read a file inside an app's own storage —
          so the copy is handed over as a content Uri and the read is granted to the packages
          that do the playing (SoundStore.grantToSystem). Not exported: nothing but a grant of
          ours opens it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sounds"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/sound_paths" />
        </provider>
    </application>
</manifest>
